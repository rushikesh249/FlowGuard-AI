# FlowGuard AI — environment configuration example
# Copy to .env and adjust values for your environment.
# docker-compose.yml currently sets these inline; use this file as reference
# or switch the compose file to env_file: if you externalize configuration.

# ── Backend / Worker ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://flowguard:flowguard@postgres:5432/flowguard
REDIS_URL=redis://redis:6379/0
JWT_SECRET=flowguard-dev-secret-change-in-production

# ── Frontend (baked into the Next.js build at compile time) ─────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
